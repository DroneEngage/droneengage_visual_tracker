{
    "module_id": "VIS_TRK_PRO",
    "s2s_udp_target_ip": "127.0.0.1",
    "s2s_udp_target_port": "60000",
    "s2s_udp_listening_ip": "127.0.0.1",
    "s2s_udp_listening_port": "60053",
    "s2s_udp_packet_size": "8192",
    // tracker_algorithm_index:
    //   -1 = AUTO: CSRT when total RAM >= tracker_auto_csrt_min_mem_mb
    //        (default 3072 MB), KCF on low-memory boards.
    /*
    enum ENUM_TRACKER_TYPE
    {
        TRACKER_BOOSTING    = 0,
        TRACKER_MIL         = 1,
        TRACKER_KCF         = 2,
        TRACKER_TLD         = 3,
        TRACKER_MEDIANFLOW  = 4,
        TRACKER_GOTURN      = 5,
        TRACKER_MOSSE       = 6,
        TRACKER_CSRT        = 7,
    };
    */
    "camera": {
        // Specific Module Parameters
        "source_video_device"               : "/dev/video0", // "/dev/video57", //57",
        //"output_video_device": "/dev/video3"
        //"source_video_device_name"          : "SIM-CAM1", //"SIM-CAM1", //"C270 HD WEBCAM",  // DE-RPI,DE-THERMAL,
        "output_video_device_name"          : "DE-TRK"
        //"cam_id"                          : "cam0",       // module-layer camera id; stamped as overlay target t ahead of device names
        //"overlay_target"                  : "cam0",       // explicit CAMERA_OVERLAY_ACTION t override; wins over cam_id/device fields
        //"desired_input_width"               : 1280,
        //"desired_input_height"              : 720
    },
    "tracking": {
        "tracker_algorithm_index": 7,
        "camera_orientation": 0, // 0b0000 bit:0 horizontal/vertical, bits1,2: rotation (0,90,180,270)
        "camera_flipped": false,
        "tracking_camera_direction": 4,  // none, front , back , down , up 
        "crosshair": false,
        // when true the tracking rectangle is sent to de_camera to draw it
        // using its internal overlay library instead of drawing it locally
        "de_camera_draw": true
    },
    "advanced_tracking": {
        "frames_to_skip_between_messages": 2,
        "frame_to_skip_between_track_process": 2,
        "ema_alpha_base": 0.3,
        "lock_class_reacquire_frames": 15,      // lock {class}: observation frames a locked track may be absent before another track of the class is taken
        "lock_reseed_cooldown_frames": 10,      // observation frames between re-seeds while the pixel tracker is not tracking
        "ai_assisted_recovery_enabled": true,   // Enable AI-assisted recovery
        "ai_priority": true,                    // re-seed the pixel tracker on the locked track when it drifts away from it
        "ai_priority_distance_threshold": 0.3,  // Distance threshold for "out of square" (20% of image diagonal)
        "tracker_lost_timeout_ms": 10000        // Timeout for manual intervention (when AI disabled)
    }
}